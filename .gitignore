# Only explicitly reviewed public files are tracked.
# Extend this allowlist when new public files are ready.
/*
!/.gitignore
!/README.md
!/package.json
!/package-lock.json
!/.node-version
!/.python-version
!/.editorconfig
!/.gitattributes
!/.dockerignore
!/compose.yaml
!/apps/
/apps/*
!/apps/web/
!/apps/api/
!/supabase/
/supabase/*
!/supabase/migrations/
!/guides/
/guides/*
!/guides/setup.md
!/guides/deployment.md
!/guides/architecture.md
!/guides/ai-roadmap.md
!/assets/
/assets/*
!/assets/screenshots/
!/assets/diagrams/
/assets/diagrams/*
!/assets/diagrams/system-architecture.png
/assets/screenshots/*
!/assets/screenshots/calendar-desktop.png
!/assets/screenshots/calendar-mobile.png
!/assets/screenshots/plan-desktop.png
!/assets/screenshots/memories-mobile.png
!/assets/screenshots/white-mobile.png

# Local credentials, dependencies, and generated output are never published.
**/.env*
!**/.env.example
**/node_modules/
**/.next/
**/.venv/
**/__pycache__/
**/*.pyc
**/*.egg-info/
**/.pytest_cache/
**/.ruff_cache/
**/test-results/
**/playwright-report/
**/*.tsbuildinfo
**/*.log
**/dist/
**/AGENTS.md
**/next-env.d.ts

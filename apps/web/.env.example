# Copy to apps/web/.env. These values are read on the server at runtime.
WE2DAY_SITE_URL=http://127.0.0.1:3000
WE2DAY_SUPABASE_URL=
WE2DAY_SUPABASE_PUBLISHABLE_KEY=
# password: pre-created username/password accounts only.
# Social-only: google,kakao. Both: password,google,kakao. Empty disables all methods.
WE2DAY_AUTH_PROVIDERS=password
# Compose overrides this with http://api:8000 for container-to-container requests.
WE2DAY_API_URL=http://127.0.0.1:8000

# Optional NAVER Cloud Maps Dynamic Map browser client ID (public, not a secret).
# Register allowed Web service URL in Maps console; no client secret belongs here.
WE2DAY_NAVER_MAPS_CLIENT_ID=

# Copy to apps/api/.env. Use an empty value until a Supabase project is configured.
WE2DAY_SUPABASE_URL=
WE2DAY_SUPABASE_PUBLISHABLE_KEY=
WE2DAY_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Optional NAVER API HUB > NAVER Search > Region. Server only; not Maps keys.
# Enable only after checking the current terms, pricing, and console usage limits.
WE2DAY_NAVER_SEARCH_ENABLED=false
WE2DAY_NAVER_SEARCH_CLIENT_ID=
WE2DAY_NAVER_SEARCH_CLIENT_SECRET=

# Optional caller-owned device tests. Private key is base64url P-256 scalar; server only.
WE2DAY_PUSH_ENABLED=false
# Enable only after SQL024 and the separately configured worker pass their access checks.
WE2DAY_PUSH_AUTOMATIC_ENABLED=false
WE2DAY_PUSH_PRIVATE_KEY=
WE2DAY_PUSH_SUBJECT=

            "title": "Action"
          },
          "content": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PlanContent"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "expected_version",
          "action"
        ],
        "title": "AgentPlanChange"
      },
      "AgentPlanView": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "content": {
            "$ref": "#/components/schemas/PlanContent"
          },
          "published_content": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PlanContent"
              },
              {
                "type": "null"
              }
            ]
          },
          "published_revision": {
            "type": "integer",
            "title": "Published Revision"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "archived": {
            "type": "boolean",
            "title": "Archived",
            "default": false
          },
          "appointment_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Appointment Id"
          },
          "appointment_version": {
            "type": "integer",
            "title": "Appointment Version",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "id",
          "content",
          "published_content",
          "published_revision",
          "version"
        ],
        "title": "AgentPlanView"
      },
      "AppointmentInput": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Title"
          },
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "time": {
            "anyOf": [
              {
                "type": "string",
                "format": "time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time"
          },
          "place": {
            "type": "string",
            "maxLength": 200,
            "title": "Place",
            "default": ""
          },
          "note": {
            "type": "string",
            "maxLength": 2000,
            "title": "Note",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "date"
        ],
        "title": "AppointmentInput"
      },
      "DraftInput": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "content": {
            "$ref": "#/components/schemas/PlanContent"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "request_id",
          "content"
        ],
        "title": "DraftInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PlanContent": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Title"
          },
          "date": {
            "type": "string",
            "pattern": "^(20\\d{2}|2100)-\\d{2}-\\d{2}$",
            "title": "Date"
          },
          "budget": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1000000000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget"
          },
          "transport": {
            "type": "string",
            "maxLength": 40,
            "title": "Transport",
            "default": ""
          },
          "activities": {
            "items": {
              "$ref": "#/components/schemas/Activity"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Activities"
          },
          "preparation": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Preparation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "date"
        ],
        "title": "PlanContent"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "servers": [
    {
      "url": "https://your-domain.example/api/agent/v1"
    }
  ]
}

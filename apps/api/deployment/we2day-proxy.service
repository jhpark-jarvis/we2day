[Unit]
Description=WE2DAY dedicated HTTPS reverse proxy
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
RuntimeDirectory=we2day-proxy
RuntimeDirectoryMode=0755
ExecStartPre=/usr/sbin/nginx -t -c /etc/we2day-proxy/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/we2day-proxy/nginx.conf -g "daemon off;"
ExecReload=/usr/sbin/nginx -t -c /etc/we2day-proxy/nginx.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
KillSignal=SIGQUIT
TimeoutStopSec=15s
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/we2day-proxy
MemoryMax=48M
MemorySwapMax=32M
TasksMax=32
CPUQuota=25%

[Install]
WantedBy=multi-user.target

# Compose settings only; copy outside the checkout as .env beside compose.yaml.
# Keep the credential-bearing runtime.env in a separate protected directory.
WE2DAY_BACKUP_IMAGE=we2day-backup:local
WE2DAY_BACKUP_UID=1000
WE2DAY_BACKUP_GID=1000
WE2DAY_BACKUP_CONFIG_DIR=/private/config
WE2DAY_BACKUP_KEYS_DIR=/private/keys
WE2DAY_BACKUP_CA_FILE=/private/config/supabase-ca.crt
WE2DAY_BACKUP_COPIES_DIR=/private/daily-copies

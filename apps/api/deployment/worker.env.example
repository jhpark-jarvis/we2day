# Private worker-only file. Do not merge into web.env or api.env.
# Copy the exact pooler host/port from Supabase Connect. Use the dedicated role, never postgres.
# Download the official CA to ./supabase-ca.crt beside compose.yaml.
# DSN options: sslmode=verify-full&sslrootcert=/run/we2day/supabase-ca.crt
WE2DAY_REMINDER_WORKER_ENABLED=false
WE2DAY_REMINDER_DATABASE_URL=
WE2DAY_PUSH_ENABLED=true
# Reuse the API server's existing private key and subject through a protected server-side copy.
WE2DAY_PUSH_PRIVATE_KEY=
WE2DAY_PUSH_SUBJECT=
